# Optional public Preprod operator address. The private test seed is never needed by the server.
# OPERATOR_ADDRESS=addr_test1...
PORT=5179

# Existing deployed Outreach Coworker; its worker launches the four Scouts.
OUTREACH_COWORKER_ID=01a191fd-9561-7777-8886-ec6f6dc9f7cd
# Optional local audit mount for verified individual Scout session statuses.
OUTREACH_TRACE_DIR=../masumi-agent/.local
